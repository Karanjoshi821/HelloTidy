# Copy to .env.local for local development. In production, set these in
# Vercel → Project → Settings → Environment Variables, then redeploy.
# Integrations switch on only when their variables are present.

# ── Required in production ─────────────────────────────────────────────
# Your live domain, no trailing slash. Used for canonical URLs, sitemap, OG.
NEXT_PUBLIC_SITE_URL=https://www.example.in

# Postgres. `vercel integration add neon` sets these automatically.
# Leave empty locally to use the built-in embedded database (PGlite).
DATABASE_URL=
# Direct (non-pooled) connection, used for migrations if present.
DATABASE_URL_UNPOOLED=

# Long random string. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=

# ── Razorpay (online payments) ─────────────────────────────────────────
# Dashboard → Account & Settings → API Keys. Use rzp_test_… keys to test first.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Webhooks → URL https://<domain>/api/webhooks/razorpay
# Events: payment.authorized, payment.captured, payment.failed, order.paid
RAZORPAY_WEBHOOK_SECRET=

# ── Meta Pixel + Conversions API (ads tracking) ────────────────────────
# Events Manager → Data sources → your pixel (the dataset ID).
NEXT_PUBLIC_META_PIXEL_ID=
# Events Manager → Settings → Conversions API → Generate access token.
META_CAPI_ACCESS_TOKEN=
# Optional: Events Manager → Test events → test code (remove after testing).
META_CAPI_TEST_EVENT_CODE=
# Optional override of the Graph API version.
META_GRAPH_API_VERSION=v25.0

# ── Telegram alert on every new order (free) ───────────────────────────
# 1. Message @BotFather → /newbot → copy the token.
# 2. Send any message to your bot, then open
#    https://api.telegram.org/bot<TOKEN>/getUpdates and copy "chat":{"id":…}.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Order emails via Resend (optional) ─────────────────────────────────
RESEND_API_KEY=
# Must be on a domain you verified in Resend, e.g. "Hello Tidy <orders@hellotidy.in>"
EMAIL_FROM=
# Where to send a copy of every new order.
OWNER_EMAIL=

# ── Cart-recovery calls (AI voice agent + n8n) ─────────────────────────
# Off until RECOVERY_API_KEY is set. Then checkout shows a call-consent box, and
# n8n and the voice agent use /api/recovery/... with this key as a Bearer token.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
RECOVERY_API_KEY=
# n8n webhook that starts the automation for each saved cart, and the header token it checks (X-Kivo-Token).
RECOVERY_WEBHOOK_URL=http://localhost:5678/webhook/kivo-cart-saved
RECOVERY_WEBHOOK_TOKEN=
# Most a call may offer (percent), how long its code lasts, and how many call attempts per cart.
RECOVERY_MAX_DISCOUNT_PERCENT=10
RECOVERY_COUPON_HOURS=48
RECOVERY_MAX_CALL_ATTEMPTS=2
# Calls only between these hours, India time. TRAI allows 9 am to 9 pm for business calls.
RECOVERY_CALL_HOURS=9-21

# ── Outgoing order webhook (for the future order-notification app) ─────
# POSTs a signed "order.confirmed" event. See src/lib/notify/webhook.ts.
ORDER_WEBHOOK_URL=
ORDER_WEBHOOK_SECRET=
