{
  "name": "hello-tidy-store",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "tsx scripts/migrate.ts --if-configured && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "admin:create": "tsx scripts/create-admin.ts",
    "check:launch": "tsx scripts/check-launch.ts",
    "test:e2e": "tsx tests/e2e/smoke.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:qa": "tsx tests/e2e/qa.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@vercel/functions": "^3.10.3",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-core": "^4.14.0",
    "dotenv": "^18.0.9",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "playwright-core": "^1.64.1",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "zod": "$zod"
  },
  "engines": {
    "node": ">=22.12"
  }
}
